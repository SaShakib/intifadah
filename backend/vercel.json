{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/internal/cron/quran-daily-reminder",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/internal/cron/quran-weekly-penalty",
      "schedule": "10 18 * * 4"
    }
  ],
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
